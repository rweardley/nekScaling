//
// nekRS User Defined File
//

#include "planarCopy.hpp"

deviceMemory<int> o_bID;
planarCopy* recyc = nullptr;
dfloat u_avg;
dfloat area;

#ifdef __okl__

#include "channel.oudf"

#endif

dfloat parabolic_vel(dfloat u_avg, dfloat coord1, dfloat coord2, dfloat coord1_max, dfloat coord2_max)
{
  // calculate parabolic velocity profile
  return ((9./4.) * u_avg * 
      (1. - (coord1 * coord1) / (coord1_max * coord1_max)) *
      (1. - (coord2 * coord2) / (coord2_max * coord2_max))
    );
}

// inductionless kernels
void UDF_LoadKernels(deviceKernelProperties& kernelInfo)
{
}

void UDF_Setup()
{
  auto &fluid = nrs->fluid;
  auto &mhdIndless = nrs->mhdIndless;

  u_avg = 1.0;

  // -----------------------------------------------------------
  // Initial conditions (ICs)
  // -----------------------------------------------------------

  if (platform->options.getArgs("RESTART FILE NAME").empty()) {

    // velocity setup
    auto mesh = fluid->mesh;
    auto [x, y, z] = mesh->xyzHost(); // x[n], y[n], z[n]
    std::vector<dfloat> U(mesh->dim * fluid->fieldOffset, 0.0);
    std::vector<dfloat> P(fluid->fieldOffset, 0.0);

    for (int n = 0; n < mesh->Nlocal; n++) {

      auto xn = x[n];
      auto yn = y[n];
      auto zn = z[n];

      auto u_x = parabolic_vel(u_avg, yn, zn, 1.0, 1.0);

      U[n + 0 * nrs->fieldOffset] = u_x;
      U[n + 1 * nrs->fieldOffset] = 0.0;
      U[n + 2 * nrs->fieldOffset] = 0.0;
      P[n] = 0.0;
    }
    fluid->o_U.copyFrom(U.data(), U.size());
    fluid->o_P.copyFrom(P.data(), P.size());
    U.clear();
    P.clear();
  }

  // -----------------------------------------------------------
  // Inductionless MHD setup
  // -----------------------------------------------------------

  if (nrs->mhdIndless) {
    auto mesh = mhdIndless->mesh;
    auto [x, y, z] = mesh->xyzHost(); // x[n], y[n], z[n]
    std::vector<dfloat> Phi(mhdIndless->fieldOffset, 0.0);
    for (int n = 0; n < mesh->Nlocal; n++) {
      Phi[n] = 0.0;
    }
    mhdIndless->o_Phi.copyFrom(Phi.data(), Phi.size());
    Phi.clear();
  }

  // -----------------------------------------------------------
  // Velocity Recycling Inlet (setup)
  // -----------------------------------------------------------

  {
    auto mesh = mhdIndless->mesh;

    platform->app->bc->o_usrwrk.resize(mesh->dim * fluid->fieldOffset);
    const auto xLen = abs(
                platform->linAlg->max(mesh->Nlocal, mesh->o_x, platform->comm.mpiComm()) -
                platform->linAlg->min(mesh->Nlocal, mesh->o_x, platform->comm.mpiComm())
              );
    const dfloat xRecyclingOffset = xLen;
  
    const int inletID = 1;
    std::vector<int> bID;
    bID.push_back(inletID);
    o_bID.resize(bID.size());
    o_bID.copyFrom(bID);
  
    deviceMemory<dfloat> o_tmp(mesh->Nlocal);
    platform->linAlg->fill(o_tmp.size(), 1.0, o_tmp);
    area = mesh->surfaceAreaMultiplyIntegrate(o_bID, o_tmp);
  
    recyc = new planarCopy(mesh, nrs->fluid->o_solution(), mesh->dim, nrs->fluid->fieldOffset, xRecyclingOffset, 0.0, 0.0, bID[0], platform->app->bc->o_usrwrk);
  }
}

void UDF_Setup0(MPI_Comm comm, setupAide &options)
{
}

void UDF_ExecuteStep(double time, int tstep)
{
  // inlet recycling
  {
    // copy solution from specified plane to inlet    
    recyc->execute();

    // normalise inlet BC to maintain flow rate
    auto uBulk = 1.0;
    const auto flux = nrs->mhdIndless->mesh->surfaceAreaNormalMultiplyVectorIntegrate(nrs->fluid->fieldOffset, o_bID, platform->app->bc->o_usrwrk);
    platform->linAlg->scale(nrs->fluid->fieldOffsetSum, -uBulk * area / flux, platform->app->bc->o_usrwrk);
  }
}
